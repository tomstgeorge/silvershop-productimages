{
    "name": "antonythorpe/silvershop-productimages",
    "type": "silverstripe-vendormodule",
    "description": "SilverShop submodule that adds multiple product images to the Product Page with a thumbnail gallery & zooming",
    "keywords": [
        "Silverstripe",
        "SilverShop",
        "multiple images",
        "extended images"
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "php": "^8.1 || ^8.3",
        "bummzack/sortablefile": "dev-master",
        "silvershop/core": "dev-main",
        "silverstripe/cms": "^6",
        "silverstripe/vendor-plugin": "^2 || ^3"
    },
    "require-dev": {
        "cambis/silverstan": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "AntonyThorpe\\SilverShopProductImages\\": "src/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-master": "1.*-dev"
        },
        "expose": [
            "client"
        ]
    },
    "license": "MIT"
}
